# Copia este archivo a .env y ajusta los valores.
# Docker Compose lee .env automáticamente.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Amazon Bedrock (agente de Strands)
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo con credenciales temporales (SSO, roles asumidos):
# AWS_SESSION_TOKEN=
# Opcional: modelo de Bedrock (id o perfil de inferencia)
# BEDROCK_MODEL_ID=global.anthropic.claude-opus-5-5

# Tavily (búsqueda web del agente)
TAVILY_API_KEY=
